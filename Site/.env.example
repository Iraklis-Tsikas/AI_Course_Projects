# Copy to .env and fill in. SERVER-SIDE ONLY — read by server/main.ts, never by Angular code.

# Google Gemini (AI Studio free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Optional: port for the Digital Twin API in dev (the Angular dev server proxies /api to it)
# TWIN_PORT=4300
